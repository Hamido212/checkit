<Window x:Class="Checkit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Checkit — Deine Haltestelle" Width="470" Height="360" MinWidth="300" MinHeight="210" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#111317" Foreground="#F5F6F7" FontFamily="Segoe UI" Loaded="OnLoaded" Closing="OnClosing" SizeChanged="OnSizeChanged">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#25282D"/><Setter Property="Foreground" Value="#F5F6F7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="3,0"/><Setter Property="Cursor" Value="Hand"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#25282D"/><Setter Property="Foreground" Value="#F5F6F7"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#555A62"/><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<Border BorderBrush="#596266" BorderThickness="1" Padding="7" Background="#252829" CornerRadius="12"><Border Padding="14" Background="#0D0F10" CornerRadius="6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid MouseLeftButtonDown="DragHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CHECKIT / BREMEN" FontSize="9" Foreground="#A8ADB5"/><TextBlock x:Name="Station" Text="Bremen Hauptbahnhof" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,4,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="⚙" Click="ToggleSettings" ToolTip="Haltestelle ändern"/><Button x:Name="Pin" Content="◇" Click="TogglePin" ToolTip="Immer im Vordergrund"/><Button Content="−" Click="Minimize" ToolTip="Minimieren"/><Button Content="×" Click="CloseWindow" ToolTip="Schließen"/></StackPanel></Grid>
<Grid Grid.Row="1" Margin="0,9,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Verbinde …" Foreground="#A8ADB5" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" x:Name="RefreshButton" Content="↻" Click="ManualRefresh" Foreground="#FFB51B" ToolTip="Jetzt aktualisieren"/></Grid>
<StackPanel Grid.Row="2" x:Name="Settings" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="Haltestelle suchen" Margin="0,0,0,6"/><DockPanel><Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Suchen" Click="Search"/><TextBox x:Name="Query" ToolTip="z. B. Bremen Domsheide" KeyDown="QueryKeyDown"/></DockPanel><ListBox x:Name="Results" MaxHeight="155" DisplayMemberPath="name" Background="#25282D" Foreground="White" Margin="0,6,0,0" SelectionChanged="SelectStop"/></StackPanel>
<StackPanel x:Name="Rows" Grid.Row="3" ClipToBounds="True"/><TextBlock Grid.Row="4" Margin="0,9,0,0" FontSize="9" Foreground="#898F99"><Hyperlink NavigateUri="https://transitous.org/sources/" RequestNavigate="OpenLink" Foreground="#898F99">Daten: Transitous / MOTIS</Hyperlink><Run Text=" · "/><Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" RequestNavigate="OpenLink" Foreground="#898F99">© OpenStreetMap</Hyperlink></TextBlock>
</Grid></Border></Border></Window>

